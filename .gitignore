*.mp4
*.MP4
*.mov
*.MOV
clips/
*.pt
# RF-DETR detector checkpoint - downloaded on first use, see inference.ensure_rfdetr_weights
*.pth
*.pth.part
# exported inference weights - 167MB, and reproducible from the .pt with
# shot-clipper-export-onnx
*.onnx
__pycache__/
*.pyc
.venv/
venv/
.DS_Store

.omc/
.claude/*
# skills are reusable project workflows, meant to be committed and shared -
# unlike everything else under .claude/ (local settings, session state)
!.claude/skills/

# poetry-managed venv if created in-repo
.venv*/
dist/
*.egg-info/
.pytest_cache/

# label UI job status files (ephemeral runtime state, not project data)
data/jobs/
data/thumbnails_cache/
# AI pre-label models/scores/training rows: contain other accounts' names,
# and the repo is public - see data/prelabel/README.md
data/prelabel/
# player-identification gallery: embeddings + people's names, local only
data/players/

# Windows installer build output (installer/build-installer.ps1) - dist/
# above already covers installer/dist/ (the compiled .exe)
installer/stage/

# left behind on disk by the v2 branch's frontend/ (which has its own
# .gitignore there) when switching back to a branch without it
node_modules/

# Remotion highlight-reel project: third-party agent skills are restored from
# remotion-reel/skills-lock.json (npx skills experimental_install), so only the
# lock file is tracked; renders and the clips shot-clipper-highlights stages
# into public/ are build output.
remotion-reel/.claude/
remotion-reel/out/
remotion-reel/public/clips/
remotion-reel/public/reels/
